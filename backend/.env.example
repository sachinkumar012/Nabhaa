# ─── Email Configuration ───────────────────────────────────────────────────────
# Option 1: Use Resend API (Recommended for Production/Render - No timeout issues)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=Nabha Healthcare <onboarding@resend.dev>

# Option 2: Gmail SMTP (Optional - use as fallback or local development)
# Get app password from: https://myaccount.google.com/apppasswords
# NOTE: Must use App Password, NOT regular Gmail password!
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password-without-spaces
# SMTP_HOST=smtp.gmail.com

# ─── SMS Configuration (Optional) ───────────────────────────────────────────────
# For SMS OTP fallback (if using phone numbers)
# FAST2SMS_API_KEY=your_fast2sms_api_key

# ─── Production Variables (Set in Render Dashboard) ──────────────────────────────
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/nabha
JWT_SECRET=your-jwt-secret-key
NODE_ENV=production
PORT=10000

# API Keys
GEMINI_API_KEY=your-gemini-api-key
CORS_ORIGIN=https://nabha-frontend.onrender.com,https://nabha-admin.onrender.com

# Payment Gateway
RAZORPAY_KEY_ID=your-razorpay-key
RAZORPAY_KEY_SECRET=your-razorpay-secret
