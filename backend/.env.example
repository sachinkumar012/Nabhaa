# ─── Backend Environment Variables ─────────────────────────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file — it is listed in .gitignore.

# ── Server ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ────────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/nabhaa?retryWrites=true&w=majority

# ── Auth / JWT ───────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=change_me_to_another_long_random_string
JWT_REFRESH_EXPIRE=30d

# ── Google OAuth ─────────────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# ── CORS ─────────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# ── Frontend URL (used by Razorpay payment callback redirect) ────────────────────
FRONTEND_URL=http://localhost:5173

# ── AI Integration ───────────────────────────────────────────────────────────────
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# ── Email — Resend API (recommended for production) ──────────────────────────────
# Sign up at https://resend.com and get your API key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM=Nabha Healthcare <onboarding@resend.dev>

# ── Email — Gmail SMTP (local dev fallback) ───────────────────────────────────────
# Use an App Password (NOT your regular password): https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your_16_char_app_password

# ── Payment Gateway — Razorpay ────────────────────────────────────────────────────
# Get keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
# Webhook secret — set this in Razorpay Dashboard → Webhooks
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ── Cloud Storage — Cloudinary ────────────────────────────────────────────────────
# Get credentials from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── SMS — Fast2SMS (optional) ─────────────────────────────────────────────────────
# FAST2SMS_API_KEY=your_fast2sms_api_key
